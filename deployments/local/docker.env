APP_ENV=docker

# Satu database = satu bounded context: lima instance PostgreSQL terpisah,
# masing-masing di depan PgBouncer-nya sendiri (lihat docker-compose.yml).
# Tiap microservice membaca <MODULE>_DB_* dan menunjuk ke PgBouncer context-nya.
DB_DRIVER=postgres
DB_USERNAME=DRAGON
DB_PASSWORD=DRAGON

# Konteks bounded (untuk referensi / tooling):
DB_IDENTITY_HOST=pgbouncer_identity
DB_IDENTITY_PORT=5432
DB_IDENTITY_NAME=pos_identity
DB_MERCHANT_HOST=pgbouncer_merchant
DB_MERCHANT_PORT=5432
DB_MERCHANT_NAME=pos_merchant
DB_CATALOG_HOST=pgbouncer_catalog
DB_CATALOG_PORT=5432
DB_CATALOG_NAME=pos_catalog
DB_SALES_HOST=pgbouncer_sales
DB_SALES_PORT=5432
DB_SALES_NAME=pos_sales
DB_EMAIL_HOST=pgbouncer_email
DB_EMAIL_PORT=5432
DB_EMAIL_NAME=pos_email

# ---- Spring Boot per-bounded-context datasources (dipakai tiap service) ----
ROLE_DB_HOST=pgbouncer_identity
ROLE_DB_PORT=5432
ROLE_DB_NAME=pos_identity
ROLE_DB_USER=DRAGON
ROLE_DB_PASSWORD=DRAGON
USER_DB_HOST=pgbouncer_identity
USER_DB_PORT=5432
USER_DB_NAME=pos_identity
USER_DB_USER=DRAGON
USER_DB_PASSWORD=DRAGON
AUTH_DB_HOST=pgbouncer_identity
AUTH_DB_PORT=5432
AUTH_DB_NAME=pos_identity
AUTH_DB_USER=DRAGON
AUTH_DB_PASSWORD=DRAGON
MERCHANT_DB_HOST=pgbouncer_merchant
MERCHANT_DB_PORT=5432
MERCHANT_DB_NAME=pos_merchant
MERCHANT_DB_USER=DRAGON
MERCHANT_DB_PASSWORD=DRAGON
CASHIER_DB_HOST=pgbouncer_sales
CASHIER_DB_PORT=5432
CASHIER_DB_NAME=pos_sales
CASHIER_DB_USER=DRAGON
CASHIER_DB_PASSWORD=DRAGON
PRODUCT_DB_HOST=pgbouncer_catalog
PRODUCT_DB_PORT=5432
PRODUCT_DB_NAME=pos_catalog
PRODUCT_DB_USER=DRAGON
PRODUCT_DB_PASSWORD=DRAGON
CATEGORY_DB_HOST=pgbouncer_catalog
CATEGORY_DB_PORT=5432
CATEGORY_DB_NAME=pos_catalog
CATEGORY_DB_USER=DRAGON
CATEGORY_DB_PASSWORD=DRAGON
ORDER_DB_HOST=pgbouncer_sales
ORDER_DB_PORT=5432
ORDER_DB_NAME=pos_sales
ORDER_DB_USER=DRAGON
ORDER_DB_PASSWORD=DRAGON
ORDER_ITEM_DB_HOST=pgbouncer_sales
ORDER_ITEM_DB_PORT=5432
ORDER_ITEM_DB_NAME=pos_sales
ORDER_ITEM_DB_USER=DRAGON
ORDER_ITEM_DB_PASSWORD=DRAGON
TRANSACTION_DB_HOST=pgbouncer_sales
TRANSACTION_DB_PORT=5432
TRANSACTION_DB_NAME=pos_sales
TRANSACTION_DB_USER=DRAGON
TRANSACTION_DB_PASSWORD=DRAGON

SECRET_KEY=yantopedia

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=dragon_knight

KAFKA_BROKERS=kafka:9092

# ClickHouse (stats pipeline F3)
CLICKHOUSE_ADDR=clickhouse:9000
CLICKHOUSE_DATABASE=pos
CLICKHOUSE_USERNAME=dragon
CLICKHOUSE_PASSWORD=dragon_knight
# JDBC URL for the Spring Boot stats services (HTTP interface on 8123).
CLICKHOUSE_URL=jdbc:clickhouse://clickhouse:8123/pos

# ---- Spring Boot gRPC client resolution (gateway + inter-service) ----
# Relaxed binding: GRPC_CLIENT_<NAME>_HOST/_PORT -> grpc.client.<name>.host/port.
GATEWAY_PORT=5000
EMAIL_HTTP_PORT=8098
GRPC_CLIENT_ROLE_HOST=role
GRPC_CLIENT_ROLE_PORT=9006
GRPC_CLIENT_USER_HOST=user
GRPC_CLIENT_USER_PORT=9011
GRPC_CLIENT_AUTH_HOST=auth
GRPC_CLIENT_AUTH_PORT=9012
GRPC_CLIENT_MERCHANT_HOST=merchant
GRPC_CLIENT_MERCHANT_PORT=9005
GRPC_CLIENT_CASHIER_HOST=cashier
GRPC_CLIENT_CASHIER_PORT=9014
GRPC_CLIENT_CATEGORY_HOST=category
GRPC_CLIENT_CATEGORY_PORT=9015
GRPC_CLIENT_PRODUCT_HOST=product
GRPC_CLIENT_PRODUCT_PORT=9003
GRPC_CLIENT_ORDER_HOST=order
GRPC_CLIENT_ORDER_PORT=9001
GRPC_CLIENT_ORDER_ITEM_HOST=orderitem
GRPC_CLIENT_ORDER_ITEM_PORT=9016
GRPC_CLIENT_TRANSACTION_HOST=transaction
GRPC_CLIENT_TRANSACTION_PORT=9009
GRPC_CLIENT_STATS_READER_HOST=stats_reader
GRPC_CLIENT_STATS_READER_PORT=9017

REDIS_DB_AUTH=0
REDIS_DB_ROLE=1
REDIS_DB_USER=2
REDIS_DB_CATEGORY=3
REDIS_DB_CASHIER=4
REDIS_DB_MERCHANT=5
REDIS_DB_ORDERITEM=6
REDIS_DB_ORDER=7
REDIS_DB_PRODUCT=8
REDIS_DB_TRANSACTION=9
REDIS_DB_APIGATEWAY=10
